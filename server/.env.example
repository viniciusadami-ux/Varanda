# Porta HTTP do servidor local. O Electron define PORT automaticamente ao hospedar.
PORT=3000

# Obrigatório em produção: ao menos 32 caracteres aleatórios.
# Em desenvolvimento, se omitido, o servidor gera um valor temporário.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Pasta absoluta opcional para anexos enviados pelos usuários.
# UPLOADS_DIR=C:\\Varanda\\uploads

# Arquivo SQLite absoluto opcional. Útil para testes isolados.
# DATABASE_PATH=C:\\Varanda\\database\\varanda.db

# development ou production
NODE_ENV=development

# Limite de participantes por canal de voz (o cliente usa mesh P2P).
MAX_VOICE_PARTICIPANTS=8

# TURN opcional para usuários fora da LAN ou atrás de NAT simétrico.
# Configure as três variáveis com as credenciais do seu provedor TURN.
# TURN_URL=turns:turn.example.com:5349?transport=tcp
# TURN_USERNAME=temporary-or-static-username
# TURN_CREDENTIAL=temporary-or-static-password
